@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = "/Views/Shared/_LoginLayout.cshtml";
}

<main class="login-page">
    <section class="login-card" aria-labelledby="login-title">
        <div class="login-card__heading">
            <p class="login-card__eyebrow">Secure toolroom access</p>
            <h1 id="login-title">Welcome back</h1>
            <p>Log in to continue to ToolLogix.</p>
        </div>

        <form id="account" method="post" class="login-form">
            <div asp-validation-summary="ModelOnly"
                 class="login-validation text-danger"
                 role="alert"></div>

            <div class="form-floating login-field">
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating login-field">
                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="Password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="login-options">
                <label asp-for="Input.RememberMe" class="login-remember">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <span>@Html.DisplayNameFor(m => m.Input.RememberMe)</span>
                </label>

                <a id="forgot-password" class="login-link" asp-page="./ForgotPassword">
                    Forgot password?
                </a>
            </div>

            <button id="login-submit" type="submit" class="login-submit">
                Log in
            </button>

            <div class="login-secondary-links">
                <a class="login-link"
                   asp-page="/Account/Register"
                   asp-route-returnUrl="@Model.ReturnUrl">
                    Register a new account
                </a>

                <a id="resend-confirmation"
                   class="login-link"
                   asp-page="./ResendEmailConfirmation">
                    Resend email confirmation
                </a>
            </div>
        </form>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
