@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="manage-page">
    <header class="manage-page__header">
        <p class="manage-page__eyebrow">ToolLogix account</p>
        <h1>Account settings</h1>
        <p>Manage your profile and security preferences.</p>
    </header>

    <div class="manage-page__grid">
        <aside class="manage-page__navigation" aria-label="Account settings navigation">
            <partial name="_ManageNav" />
        </aside>

        <section class="manage-card" aria-labelledby="password-heading">
            <header class="manage-card__header">
                <h2 id="password-heading">Change password</h2>
                <p>Choose a strong, unique password for your ToolLogix account.</p>
            </header>

            <partial name="_StatusMessage" for="StatusMessage" />

            <form id="change-password-form" class="manage-form" method="post">
                <div asp-validation-summary="ModelOnly"
                     class="manage-form__validation text-danger"
                     role="alert"></div>

                <div class="form-floating manage-form__field">
                    <input asp-for="Input.OldPassword"
                           class="form-control"
                           autocomplete="current-password"
                           aria-required="true"
                           placeholder="Current password" />
                    <label asp-for="Input.OldPassword">Current password</label>
                    <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                </div>

                <div class="form-floating manage-form__field">
                    <input asp-for="Input.NewPassword"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="New password" />
                    <label asp-for="Input.NewPassword">New password</label>
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                </div>

                <div class="form-floating manage-form__field">
                    <input asp-for="Input.ConfirmPassword"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Confirm new password" />
                    <label asp-for="Input.ConfirmPassword">Confirm new password</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="manage-form__submit">
                    Update password
                </button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
