@inject SignInManager<IdentityUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<ul class="manage-nav">
    <li class="manage-nav__item">
        <a id="profile"
           class="manage-nav__link @ManageNavPages.IndexNavClass(ViewContext)"
           asp-page="./Index">Profile</a>
    </li>
    <li class="manage-nav__item">
        <a id="email"
           class="manage-nav__link @ManageNavPages.EmailNavClass(ViewContext)"
           asp-page="./Email">Email</a>
    </li>
    <li class="manage-nav__item">
        <a id="change-password"
           class="manage-nav__link @ManageNavPages.ChangePasswordNavClass(ViewContext)"
           asp-page="./ChangePassword">Password</a>
    </li>
    @if (hasExternalLogins)
    {
        <li id="external-logins" class="manage-nav__item">
            <a id="external-login"
               class="manage-nav__link @ManageNavPages.ExternalLoginsNavClass(ViewContext)"
               asp-page="./ExternalLogins">External logins</a>
        </li>
    }
    <li class="manage-nav__item">
        <a id="two-factor"
           class="manage-nav__link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)"
           asp-page="./TwoFactorAuthentication">Two-factor authentication</a>
    </li>
    <li class="manage-nav__item">
        <a id="personal-data"
           class="manage-nav__link @ManageNavPages.PersonalDataNavClass(ViewContext)"
           asp-page="./PersonalData">Personal data</a>
    </li>
</ul>
