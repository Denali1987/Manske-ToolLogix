@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "/Views/Shared/_LoginLayout.cshtml";
}

<main class="login-page">
    <section class="login-card register-card" aria-labelledby="register-title">
        <div class="login-card__heading">
            <p class="login-card__eyebrow">Secure toolroom access</p>
            <h1 id="register-title">Create account</h1>
            <p>Register to begin using ToolLogix.</p>
        </div>

        <form id="registerForm"
              asp-route-returnUrl="@Model.ReturnUrl"
              method="post"
              class="login-form">

            <div asp-validation-summary="ModelOnly"
                 class="login-validation text-danger"
                 role="alert"></div>

            <div class="form-floating login-field">
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating login-field">
                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-floating login-field">
                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Confirm password" />
                <label asp-for="Input.ConfirmPassword">Confirm password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button id="registerSubmit"
                    type="submit"
                    class="login-submit">
                Register
            </button>

            <div class="login-secondary-links">
                <span class="register-card__prompt">Already have an account?</span>
                <a class="login-link"
                   asp-page="./Login"
                   asp-route-returnUrl="@Model.ReturnUrl">
                    Return to login
                </a>
            </div>
        </form>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="register-external">
                <p class="register-external__label">Or register with</p>

                <form id="external-account"
                      asp-page="./ExternalLogin"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      method="post"
                      class="register-external__providers">

                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit"
                                class="register-external__button"
                                name="provider"
                                value="@provider.Name">
                            @provider.DisplayName
                        </button>
                    }
                </form>
            </div>
        }
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}