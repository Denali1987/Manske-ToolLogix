@model ToolLogix.Models.DowntimeDashboardViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Downtimes";
}

<div class="downtimes-page">
    <header class="downtimes-header">
        <div>
            <p class="downtimes-header__eyebrow">
                Toolroom workload
            </p>

            <h1>Downtimes</h1>

            <p>
                Analyze the current tool repair and changeover queue.
            </p>
        </div>

        @if (Model.AsOfTime.HasValue)
        {
            <div class="downtimes-as-of">
                <span>CSV data as of</span>

                <strong>
                    @Model.AsOfTime.Value.ToString("MM/dd/yyyy h:mm tt")
                </strong>

                <small>@Model.FileName</small>
            </div>
        }
    </header>

    <section class="downtime-upload-card">
        <div>
            <p class="downtime-upload-card__eyebrow">
                Import
            </p>

            <h2>Load downtime data</h2>

            <p>
                Select the latest downtime CSV export to refresh this page.
            </p>
        </div>

        <form asp-controller="Downtimes"
              asp-action="Index"
              method="post"
              enctype="multipart/form-data"
              class="downtime-upload-form">

            <div class="downtime-upload-field">
                <label asp-for="CsvFile"></label>

                <input asp-for="CsvFile"
                       type="file"
                       accept=".csv,text/csv" />

                <span asp-validation-for="CsvFile"></span>
            </div>

            <button type="submit">
                Analyze CSV
            </button>
        </form>

        <div asp-validation-summary="ModelOnly"
             class="downtime-validation">
        </div>
    </section>

    @if (Model.AsOfTime.HasValue)
    {
        <section class="downtime-summary"
                 aria-label="Current downtime summary">

            <article class="downtime-summary-card downtime-summary-card--repair">
                <span>Repair in process</span>
                <strong>@Model.RepairInProcessCount</strong>
            </article>

            <article class="downtime-summary-card downtime-summary-card--changeover">
                <span>Changeovers in process</span>
                <strong>@Model.ChangeoverInProcessCount</strong>
            </article>

            <article class="downtime-summary-card downtime-summary-card--waiting">
                <span>Waiting for repair</span>
                <strong>@Model.WaitingForRepairCount</strong>
            </article>

            <article class="downtime-summary-card downtime-summary-card--waiting">
                <span>Waiting for changeover</span>
                <strong>@Model.WaitingForChangeoverCount</strong>
            </article>
        </section>

        @if (Model.Warnings.Count > 0)
        {
            <aside class="downtime-warnings">
                <strong>Data notes</strong>

                <ul>
                    @foreach (var warning in Model.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </aside>
        }

        <section class="downtime-analytics"
                 aria-labelledby="downtime-analytics-heading">
            <div class="downtime-analytics__header">
                <div>
                    <p class="downtime-results-card__eyebrow">Downtime analysis</p>
                    <h2 id="downtime-analytics-heading">Where downtime is accumulating</h2>
                    <p>Charted values are downtime hours for the selected codes, presses, and tools.</p>
                </div>
                <div class="downtime-analytics__totals">
                    <span id="analytics-record-count">0 records</span>
                    <strong id="analytics-total-hours">0.00 hours</strong>
                </div>
            </div>

            <div class="downtime-analytics-controls">
                <div class="downtime-analytics-control">
                    <label for="analytics-group-by">Group chart by</label>
                    <select id="analytics-group-by">
                        <option value="tool" selected>Tool / die</option>
                        <option value="workCenter">Work center</option>
                        <option value="employeeName">Employee</option>
                        <option value="downtimeReasonCode">Downtime code</option>
                    </select>
                </div>
                <div class="downtime-analytics-control">
                    <label for="analytics-top-count">Show</label>
                    <select id="analytics-top-count">
                        <option value="5">Top 5</option>
                        <option value="10">Top 10</option>
                        <option value="15" selected>Top 15</option>
                        <option value="25">Top 25</option>
                        <option value="50">Top 50</option>
                    </select>
                </div>
                <div class="downtime-analytics-control downtime-analytics-control--wide">
                    <label for="analytics-work-centers">Work centers <small>Leave blank for all</small></label>
                    <select id="analytics-work-centers" multiple size="5">
                        @foreach (var workCenter in Model.WorkCenterOptions)
                        {
                            <option value="@workCenter">@workCenter</option>
                        }
                    </select>
                </div>
                <div class="downtime-analytics-control downtime-analytics-control--wide">
                    <label for="analytics-tools">Tools / dies <small>Leave blank for all</small></label>
                    <select id="analytics-tools" multiple size="5">
                        @foreach (var tool in Model.ToolOptions)
                        {
                            <option value="@tool">@tool</option>
                        }
                    </select>
                </div>
            </div>

            <details class="downtime-code-filter" open>
                <summary>Downtime codes <span id="analytics-selected-code-count"></span></summary>
                <div class="downtime-code-filter__actions">
                    <button type="button" id="analytics-select-active-codes">Active toolroom codes</button>
                    <button type="button" id="analytics-select-all-codes">Select all</button>
                    <button type="button" id="analytics-clear-codes">Clear</button>
                    <button type="button" id="analytics-reset-filters">Reset all filters</button>
                </div>
                <div class="downtime-code-filter__grid">
                    @foreach (var option in Model.CodeOptions)
                    {
                        <label>
                            @if (option.SelectedByDefault)
                            {
                                <input type="checkbox"
                                       value="@option.Value"
                                       data-analytics-code
                                       data-default-selected="true"
                                       checked />
                            }
                            else
                            {
                                <input type="checkbox"
                                       value="@option.Value"
                                       data-analytics-code
                                       data-default-selected="false" />
                            }
                            <span>@option.Label</span>
                        </label>
                    }
                </div>
            </details>

            <div class="downtime-bar-chart"
                 id="downtime-bar-chart"
                 aria-label="Downtime hours bar chart"></div>
        </section>

        <section class="downtime-results-card downtime-analytics-table-card"
                 aria-labelledby="downtime-detail-heading">
            <div class="downtime-results-card__header">
                <div>
                    <p class="downtime-results-card__eyebrow">Selected records</p>
                    <h2 id="downtime-detail-heading">Downtime detail</h2>
                </div>
                <label class="downtime-table-search">
                    <span>Search table</span>
                    <input id="analytics-table-search" type="search" placeholder="Search visible columns" />
                </label>
            </div>
            <div class="downtime-table-wrapper">
                <table class="downtime-table downtime-analytics-table">
                    <thead>
                        <tr>
                            <th><button type="button" data-sort-key="workCenter">Work center</button></th>
                            <th><button type="button" data-sort-key="tool">Tool / die</button></th>
                            <th><button type="button" data-sort-key="downtimeReasonCode">Code</button></th>
                            <th><button type="button" data-sort-key="downtimeReason">Reason</button></th>
                            <th><button type="button" data-sort-key="employeeName">Employee</button></th>
                            <th><button type="button" data-sort-key="workOrder">Work order</button></th>
                            <th><button type="button" data-sort-key="partNumber">Part number</button></th>
                            <th><button type="button" data-sort-key="durationMinutes" data-sort-type="number">Hours</button></th>
                            <th><button type="button" data-sort-key="startTime" data-sort-type="date">Start</button></th>
                            <th><button type="button" data-sort-key="endTime" data-sort-type="date">End</button></th>
                            <th><button type="button" data-sort-key="planned">Planned</button></th>
                            <th><button type="button" data-sort-key="costed">Costed</button></th>
                        </tr>
                        <tr class="downtime-table-filters">
                            <th><input type="search" data-column-filter="workCenter" aria-label="Filter work center" /></th>
                            <th><input type="search" data-column-filter="tool" aria-label="Filter tool" /></th>
                            <th><input type="search" data-column-filter="downtimeReasonCode" aria-label="Filter downtime code" /></th>
                            <th><input type="search" data-column-filter="downtimeReason" aria-label="Filter reason" /></th>
                            <th><input type="search" data-column-filter="employeeName" aria-label="Filter employee" /></th>
                            <th><input type="search" data-column-filter="workOrder" aria-label="Filter work order" /></th>
                            <th><input type="search" data-column-filter="partNumber" aria-label="Filter part number" /></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th>
                                <select data-column-filter="planned" aria-label="Filter planned status">
                                    <option value="">All</option>
                                    <option value="true">Yes</option>
                                    <option value="false">No</option>
                                </select>
                            </th>
                            <th>
                                <select data-column-filter="costed" aria-label="Filter costed status">
                                    <option value="">All</option>
                                    <option value="true">Yes</option>
                                    <option value="false">No</option>
                                </select>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="downtime-analytics-table-body"></tbody>
                </table>
            </div>
        </section>

        <section class="downtime-results-card"
                 aria-labelledby="active-downtimes-heading">

            <div class="downtime-results-card__header">
                <div>
                    <p class="downtime-results-card__eyebrow">
                        Active toolroom work
                    </p>

                    <h2 id="active-downtimes-heading">
                        Currently in process
                    </h2>
                </div>

                <span class="downtime-results-card__count">
                    @Model.InProcess.Count
                    press@(Model.InProcess.Count == 1 ? "" : "es")
                </span>
            </div>

            <div class="downtime-table-wrapper">
                <table class="downtime-table">
                    <thead>
                        <tr>
                            <th>Press</th>
                            <th>Status</th>
                            <th>Tool</th>
                            <th>Work order</th>
                            <th>Part number</th>
                            <th>Employee</th>
                            <th>Started</th>
                            <th>Time in code</th>
                            <th>Costing</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.InProcess.Count > 0)
                        {
                            @foreach (var row in Model.InProcess)
                            {
                                var statusClass =
                                row.Status == "Tool Repair"
                                ? "downtime-status--repair"
                                : "downtime-status--changeover";

                                <tr>
                                    <td>
                                        <strong>@row.WorkCenter</strong>
                                    </td>

                                    <td>
                                        <span class="downtime-status @statusClass">
                                            @row.Status
                                        </span>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(row.Tool)
                                                                    ? "—"
                                                                    : row.Tool)
                                                                           </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(row.WorkOrder)
                                                                    ? "—"
                                                                    : row.WorkOrder)
                                                                                </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(row.PartNumber)
                                                                    ? "—"
                                                                    : row.PartNumber)
                        </td>

                                    <td>@row.EmployeeName</td>

                                    <td class="downtime-table__date">
                                        @row.StartTime.ToString("MM/dd/yyyy h:mm tt")
                                    </td>

                                    <td class="downtime-table__duration">
                                        @row.ElapsedDisplay
                                    </td>

                                    <td>
                                        @(row.Costed ? "Costed" : "Not costed")
                                    </td>
                                </tr>
                                        }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9"
                                    class="downtime-table__empty">
                                    No tool repairs or toolroom changeovers
                                    are currently in process.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="downtime-results-card"
                 aria-labelledby="waiting-downtimes-heading">

            <div class="downtime-results-card__header">
                <div>
                    <p class="downtime-results-card__eyebrow">
                        Toolroom queue
                    </p>

                    <h2 id="waiting-downtimes-heading">
                        Waiting for the toolroom
                    </h2>
                </div>

                <span class="downtime-results-card__count">
                    @Model.Waiting.Count
                    press@(Model.Waiting.Count == 1 ? "" : "es")
                </span>
            </div>

            <div class="downtime-table-wrapper">
                <table class="downtime-table">
                    <thead>
                        <tr>
                            <th>Press</th>
                            <th>Waiting for</th>
                            <th>Tool</th>
                            <th>Work order</th>
                            <th>Part number</th>
                            <th>Employee</th>
                            <th>Waiting since</th>
                            <th>Waiting time</th>
                            <th>Planned</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Waiting.Count > 0)
                        {
                            @foreach (var row in Model.Waiting)
                            {
                                var statusClass =
                                row.Status == "Waiting for Repair"
                                ? "downtime-status--waiting-repair"
                                : "downtime-status--waiting-changeover";

                                <tr>
                                    <td>
                                        <strong>@row.WorkCenter</strong>
                                    </td>

                                    <td>
                                        <span class="downtime-status @statusClass">
                                            @row.Status
                                        </span>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(row.Tool)
                                                                    ? "—"
                                                                    : row.Tool)
                                                                           </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(row.WorkOrder)
                                                                    ? "—"
                                                                    : row.WorkOrder)
                                                                                </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(row.PartNumber)
                                                                    ? "—"
                                                                    : row.PartNumber)
                        </td>

                                    <td>@row.EmployeeName</td>

                                    <td class="downtime-table__date">
                                        @row.StartTime.ToString("MM/dd/yyyy h:mm tt")
                                    </td>

                                    <td class="downtime-table__duration">
                                        @row.ElapsedDisplay
                                    </td>

                                    <td>
                                        @(row.Planned ? "Yes" : "No")
                                    </td>
                                </tr>
                                        }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9"
                                    class="downtime-table__empty">
                                    No presses are currently waiting for
                                    tool repair or changeover.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/pages/downtimes.css"
          asp-append-version="true" />
}

@if (Model.AnalyticsRecords.Count > 0)
{
    var analyticsJson = JsonSerializer.Serialize(
        Model.AnalyticsRecords,
        new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        });

    <script id="downtime-analytics-data" type="application/json">
        @Html.Raw(analyticsJson)
    </script>
}

@section Scripts {
    @if (Model.AnalyticsRecords.Count > 0)
    {
        <script src="~/js/pages/downtime-analytics.js"
                asp-append-version="true"></script>
    }
}
