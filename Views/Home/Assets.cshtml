@model ToolLogix.Models.AssetSearchViewModel

@{
    ViewData["Title"] = "Assets";
}

<div class="assets-page">
    <header class="assets-page__header">
        <p class="assets-page__eyebrow">
            ToolLogix asset library
        </p>

        <h1>Find an asset</h1>

        <p>
            Search by asset or die number to open its tooling
            information and work history.
        </p>
    </header>

    <section class="asset-search-toolbar"
             aria-label="Filter assets">

        <form class="asset-search"
              asp-controller="Home"
              asp-action="Assets"
              method="get"
              role="search"
              data-asset-search
              data-search-url="@Url.Action("SearchAssets", "Home")">

            <label class="asset-search-toolbar__label"
                   for="assetNumber">
                Search assets
            </label>

            <div class="asset-search__input-wrap">
                <svg class="asset-search__input-icon"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M10.75 4.5a6.25 6.25 0 1 0 0 12.5
                         6.25 6.25 0 0 0 0-12.5Z" />
                    <path d="m15.25 15.25 4.25 4.25" />
                </svg>

                <input id="assetNumber"
                       name="assetNumber"
                       value="@Model.SearchTerm"
                       class="asset-search__input"
                       type="search"
                       placeholder="Asset, die, part, description, or press"
                       autocomplete="off" />
            </div>

            <span class="asset-search-toolbar__hint">
                Results update automatically
            </span>
        </form>
    </section>

    <div id="asset-results-region">
        <partial name="_AssetResults"
                 model="Model" />
    </div>
</div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/pages/assets.css"
          asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pages/asset-search.js"
            asp-append-version="true"></script>
}